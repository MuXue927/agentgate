{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgate.local/schemas/task.schema.json",
  "title": "AgentGate task specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "repo",
    "goal",
    "executor",
    "verifier",
    "constraints",
    "checks",
    "budget",
    "human_approval"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "model"],
      "properties": {
        "harness": {
          "enum": ["codex", "dsh", "pi"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "model"],
      "properties": {
        "harness": {
          "enum": ["codex", "dsh", "pi"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "run", "expect"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": "string",
            "minLength": 1
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "exit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "stdout_contains": {
                "type": "string",
                "minLength": 1
              },
              "stdout_not_contains": {
                "type": "string",
                "minLength": 1
              },
              "stdout_regex": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "max_minutes_per_round",
        "max_total_minutes"
      ],
      "properties": {
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_minutes_per_round": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_total_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_execute", "before_merge"],
      "properties": {
        "before_execute": {
          "type": "boolean"
        },
        "before_merge": {
          "type": "boolean"
        }
      }
    }
  }
}

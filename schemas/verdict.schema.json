{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgate.local/schemas/verdict.schema.json",
  "title": "AgentGate verifier verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "checks", "defects", "subject"],
  "properties": {
    "verdict": {
      "enum": ["PASS", "FAIL", "BLOCKED"]
    },
    "summary": {
      "type": "string"
    },
    "subject": {
      "description": "The frozen evidence this verdict is about, copied from the verification input unchanged.",
      "type": "object",
      "additionalProperties": false,
      "required": ["base_commit", "head_sha", "diff_sha256", "changed_files"],
      "properties": {
        "base_commit": {
          "type": "string"
        },
        "head_sha": {
          "type": "string",
          "minLength": 7
        },
        "diff_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["PASS", "FAIL"]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "where",
          "why",
          "reproduce",
          "expect",
          "actual"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "reproduce": {
            "type": "string",
            "minLength": 1
          },
          "expect": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "defects": {
            "maxItems": 0
          },
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "defects": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "enum": ["FAIL", "BLOCKED"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "FAIL"
          }
        }
      },
      "then": {
        "properties": {
          "defects": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
